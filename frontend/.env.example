# Copy this file to .env and adjust as needed. Never commit the real .env.
#
# Only variables actually read by the frontend belong here. Every value here
# is bundled into client-side JavaScript at build time (Vite requires the
# VITE_ prefix for exactly this reason) - never put a secret, API key, or
# AWS/Bedrock/DynamoDB credential in this file or any VITE_ variable.

# Base URL of the FastAPI backend's versioned API. The browser talks only to
# this - never directly to AWS.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production build (AWS App Runner backend). `npm run build` runs Vite in
# `production` mode, which automatically loads `.env.production` (gitignored,
# not committed - it holds no secret, just this public HTTPS URL, but is kept
# out of git for consistency with every other .env* file in this repo) ahead
# of this `.env.example` fallback. Copy the value below into a local
# `.env.production` file if you need to rebuild against the deployed backend:
# VITE_API_BASE_URL=https://usahfepdsw.ap-south-1.awsapprunner.com/api/v1
