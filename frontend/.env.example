# Copy this file to .env and adjust as needed. Never commit the real .env.
#
# Only variables actually read by the frontend belong here. Every value here
# is bundled into client-side JavaScript at build time (Vite requires the
# VITE_ prefix for exactly this reason) - never put a secret, API key, or
# AWS/Bedrock/DynamoDB credential in this file or any VITE_ variable.

# Base URL of the FastAPI backend's versioned API. The browser talks only to
# this - never directly to AWS.
VITE_API_BASE_URL=http://localhost:8000/api/v1
