# Copy this file to .env and adjust as needed. Never commit the real .env.

APP_NAME=REGRET ENGINE
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

# Comma-separated list of allowed CORS origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO

# --- DynamoDB ---------------------------------------------------------------
# AWS credentials are NEVER set here. boto3 resolves them via the standard
# credential provider chain (env vars, ~/.aws/credentials, an assumed role,
# or an instance profile). See README.md "AWS configuration" for details.
AWS_REGION=ap-south-1
DYNAMODB_TABLE_NAME=regret-engine

# Optional. Only set this to point at a local DynamoDB-compatible endpoint
# (e.g. DynamoDB Local at http://localhost:8000). Leave blank/unset to use
# real AWS DynamoDB with the region above.
AWS_ENDPOINT_URL=

# Placeholder user id, used until real authentication is implemented.
DEFAULT_USER_ID=local-dev-user

# --- Amazon Bedrock (AI agents) ------------------------------------------------
# AWS credentials are NEVER set here - the Strands Agents SDK resolves them
# via the same boto3 credential provider chain as DynamoDB above.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_INVOKE_TIMEOUT_SECONDS=60

# --- Evidence storage ---------------------------------------------------------
# "local" is the only backend implemented so far. No AWS credentials are
# needed for it. "s3" is reserved for later and is not implemented yet.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/evidence
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_EVIDENCE_EXTENSIONS=.pdf,.docx,.txt
