# Copy this file to .env and adjust as needed. Never commit the real .env.

APP_NAME=REGRET ENGINE
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

# Comma-separated list of allowed CORS origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO

# --- DynamoDB ---------------------------------------------------------------
# AWS credentials are NEVER set here. boto3 resolves them via the standard
# credential provider chain (env vars, ~/.aws/credentials, an assumed role,
# or an instance profile). See README.md "AWS configuration" for details.
AWS_REGION=ap-south-1
DYNAMODB_TABLE_NAME=regret-engine

# Optional. Only set this to point at a local DynamoDB-compatible endpoint
# (e.g. DynamoDB Local at http://localhost:8000). Leave blank/unset to use
# real AWS DynamoDB with the region above.
AWS_ENDPOINT_URL=

# Placeholder user id, used until real authentication is implemented.
DEFAULT_USER_ID=local-dev-user

# --- Amazon Bedrock (AI agents) ------------------------------------------------
# AWS credentials are NEVER set here - the Strands Agents SDK resolves them
# via the same boto3 credential provider chain as DynamoDB above.
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
BEDROCK_INVOKE_TIMEOUT_SECONDS=60

# --- Evidence storage ---------------------------------------------------------
# "local" is the only backend implemented so far. No AWS credentials are
# needed for it. "s3" is reserved for later and is not implemented yet.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/evidence
# Only required once an S3-backed StorageBackend exists and
# STORAGE_BACKEND=s3 is selected. Required in production if/when that's the
# case - see Settings.validate_for_production.
S3_BUCKET_NAME=
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_EVIDENCE_EXTENSIONS=.pdf,.docx,.txt

# --- External research (optional) ---------------------------------------------
# Research is OFF by default. Set RESEARCH_PROVIDER=http to enable the
# built-in DuckDuckGo HTML-search provider (no API key required). Leave
# unset/"none" to disable external research entirely - the analysis
# pipeline works fully without it.
RESEARCH_PROVIDER=none
# Only needed if a future provider requires one - never commit a real key.
RESEARCH_API_KEY=
RESEARCH_MAX_QUERIES=3
RESEARCH_MAX_RESULTS_PER_QUERY=5
RESEARCH_MAX_TOTAL_SOURCES=10
RESEARCH_TIMEOUT_SECONDS=15
RESEARCH_MAX_RETRIES=2
RESEARCH_MAX_SNIPPET_CHARS=1000

# --- Analysis lifecycle / abuse protection -------------------------------------
# Wall-clock budget for one entire analysis run (all sequential agent
# stages combined) before it's treated as abandoned if still "running".
ANALYSIS_MAX_DURATION_SECONDS=600
# Extra grace period on top of the above before a stuck "running" run is
# no longer treated as active (see AnalysisOrchestrator.run_analysis).
ANALYSIS_LOCK_GRACE_SECONDS=120
# Maximum number of analysis pipelines allowed to run concurrently in this
# process. A cheap, in-process guard - not a distributed rate limiter.
MAX_CONCURRENT_ANALYSES=5
