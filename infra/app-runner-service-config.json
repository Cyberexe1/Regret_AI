{
  "ServiceName": "regret-engine-api",
  "SourceConfiguration": {
    "AuthenticationConfiguration": {
      "AccessRoleArn": "arn:aws:iam::961308088417:role/RegretEngineAppRunnerECRAccessRole"
    },
    "AutoDeploymentsEnabled": false,
    "ImageRepository": {
      "ImageIdentifier": "961308088417.dkr.ecr.ap-south-1.amazonaws.com/regret-engine-api:latest",
      "ImageRepositoryType": "ECR",
      "ImageConfiguration": {
        "Port": "8000",
        "RuntimeEnvironmentVariables": {
          "AWS_REGION": "ap-south-1",
          "DYNAMODB_TABLE_NAME": "regret-engine",
          "S3_BUCKET_NAME": "regret-engine-evidence-961308088417",
          "BEDROCK_MODEL_ID": "apac.amazon.nova-pro-v1:0",
          "APP_ENV": "production",
          "CORS_ALLOWED_ORIGINS": "https://d20l6vg17brb6a.cloudfront.net"
        }
      }
    }
  },
  "InstanceConfiguration": {
    "Cpu": "1 vCPU",
    "Memory": "2 GB",
    "InstanceRoleArn": "arn:aws:iam::961308088417:role/RegretEngineAppRunnerRole"
  },
  "HealthCheckConfiguration": {
    "Protocol": "HTTP",
    "Path": "/api/v1/health",
    "Interval": 10,
    "Timeout": 5,
    "HealthyThreshold": 1,
    "UnhealthyThreshold": 3
  }
}
